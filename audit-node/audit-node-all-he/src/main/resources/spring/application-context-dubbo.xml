<?xml version="1.0" encoding="UTF-8"?>
<beans
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:dubbo="http://dubbo.apache.org/schema/dubbo"
        xmlns="http://www.springframework.org/schema/beans"
        xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://dubbo.apache.org/schema/dubbo
        http://dubbo.apache.org/schema/dubbo/dubbo.xsd"
>

    <!-- region 基础配置 -->

    <dubbo:application name="audit-node-all-he">
        <dubbo:parameter key="qos.enable" value="false"/>
    </dubbo:application>

    <!-- Zookeeper 注册中心。 -->
    <dubbo:registry
            address="${com.dwarfeng.audit.dubbo.registry.zookeeper.address}"
            timeout="${com.dwarfeng.audit.dubbo.registry.zookeeper.timeout}"
    />

    <!-- Dubbo 协议。 -->
    <dubbo:protocol
            name="dubbo"
            port="${com.dwarfeng.audit.dubbo.protocol.dubbo.port}"
            host="${com.dwarfeng.audit.dubbo.protocol.dubbo.host}"
            dispatcher="message"
            threadpool="fixed"
            threads="100"
    />

    <!-- endregion -->

    <!-- region 服务配置 -->

    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.AuditCategoryMaintainService"
            ref="auditCategoryMaintainServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.AuditPropertyIndicatorMaintainService"
            ref="auditPropertyIndicatorMaintainServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.AuditEntryMaintainService"
            ref="auditEntryMaintainServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.AuditEntryPropertyMaintainService"
            ref="auditEntryPropertyMaintainServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.AuditRecordService"
            ref="auditRecordServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.AuditEntryLookupService"
            ref="auditEntryLookupServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.InspectionAlarmTypeIndicatorMaintainService"
            ref="inspectionAlarmTypeIndicatorMaintainServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.InspectionMaintainService"
            ref="inspectionMaintainServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.InspectionAlarmMaintainService"
            ref="inspectionAlarmMaintainServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.InspectionDriverInfoMaintainService"
            ref="inspectionDriverInfoMaintainServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.InspectionDriverSupportMaintainService"
            ref="inspectionDriverSupportMaintainServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.InspectionTaskMaintainService"
            ref="inspectionTaskMaintainServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.InspectionTaskEventMaintainService"
            ref="inspectionTaskEventMaintainServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.InspectorInfoMaintainService"
            ref="inspectorInfoMaintainServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.InspectorSupportMaintainService"
            ref="inspectorSupportMaintainServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.audit.stack.service.InspectorVariableMaintainService"
            ref="inspectorVariableMaintainServiceImpl"
            group="${com.dwarfeng.audit.dubbo.provider.group}"
    />

    <!-- endregion -->

    <!-- region 引用配置 -->

    <!-- region snowflake -->

    <dubbo:reference
            id="snowflakeGenerateService"
            interface="com.dwarfeng.sfds.stack.service.GenerateService"
            check="false"
            group="${com.dwarfeng.audit.dubbo.consumer.snowflake.group}"
    />

    <!-- endregion -->

    <!-- endregion -->
</beans>
